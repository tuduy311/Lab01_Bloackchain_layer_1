{
  "run": {
    "nodes": 8,
    "seed": 0,
    "height": 3,
    "log": "logs/run.jsonl",
    "summary": "logs/summary.json"
  },
  "simulation": {
    "gossip_interval": 0.25,
    "max_transactions": 100
  },
  "network": {
    "min_delay": 0.01,
    "max_delay": 0.05,
